# Uptime Monitoring Configuration
# Copy this file to .env and fill in actual values (do NOT commit .env to Git)

# Telegram webhook URL for notifications (includes bot token and chat ID)
# Example: https://api.telegram.org/bot123456:ABC.../sendMessage?chat_id=-12345
TELEGRAM_WEBHOOK_URL=

# Site URL to monitor (uptime-check will HTTP GET this)
UPTIME_CHECK_URL=http://localhost:3000

# PM2 process name (must match ecosystem.config.js app name)
PM2_PROCESS_NAME=ai-interface

# Consecutive failures before sending DOWN notification (default: 2 ≈ 10 minutes)
FAILURE_THRESHOLD=2
